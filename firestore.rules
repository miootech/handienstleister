rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() && request.auth.token.role is string ? request.auth.token.role : "visitor";
    }

    function isSuperAdmin() {
      return role() == "superAdmin";
    }

    function isCompanyAdmin() {
      return role() == "companyAdmin" || isSuperAdmin();
    }

    function sameCompany(companyId) {
      return isSuperAdmin() || (isCompanyAdmin() && request.auth.token.companyId == companyId);
    }

    match /companies/{companyId} {
      allow read: if sameCompany(companyId);
      allow create, update: if isSuperAdmin() || (isCompanyAdmin() && request.auth.token.companyId == companyId && !("role" in request.resource.data));
      allow delete: if isSuperAdmin();
    }

    match /users/{userId} {
      allow read: if isSuperAdmin() || request.auth.uid == userId;
      allow create, update, delete: if isSuperAdmin();
    }

    match /contactRequests/{requestId} {
      allow read: if sameCompany(resource.data.companyId);
      allow create: if false;
      allow update: if sameCompany(resource.data.companyId)
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "internalNotes",
          "assignedTo",
          "appointment",
          "archivedAt",
          "deletedAt",
          "updatedAt"
        ]);
      allow delete: if isSuperAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if resource.data.status == "approved" || sameCompany(resource.data.companyId);
      allow create: if false;
      allow update: if sameCompany(resource.data.companyId)
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "rating",
          "text",
          "companyReply",
          "profileImageUrl",
          "imageUrl",
          "publishedAt",
          "moderatedAt",
          "moderatedBy",
          "updatedAt"
        ]);
      allow delete: if sameCompany(resource.data.companyId);
    }

    match /settings/{settingId} {
      allow read: if isCompanyAdmin();
      allow write: if isSuperAdmin();
    }

    match /rateLimits/{document=**} {
      allow read, write: if false;
    }

    match /mailLogs/{document=**} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
